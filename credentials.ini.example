# Template. install.sh copies it to ./credentials.ini (mode 600; listed in .gitignore).
# pdfsign refuses to read the file if group/other can read it.
#
# The secret that unlocks the SIGNING key ("Digital Signature PIN" object on the card,
# 3 tries before PERMANENT lock). Fill in ONE of the two lines, matching secret_type in config.ini:
#   signature_password : letters/digits/symbols, printable ASCII only (no Greek), 4-16 chars
#   signature_pin      : digits only, 4-16
# Leave both empty to be asked every time. No quotes; leading/trailing spaces are not allowed.

[token]
signature_password =
signature_pin =

[identities]
# Text that marks where YOU sign; used to auto-locate the signature place in a PDF.
# One entry per line (indent continuation lines). Case, accents and punctuation are ignored;
# multi-word entries must appear as adjacent words.
#   names : primary - your name as it may be written in documents
#   roles : fallback - only used when no name is found, or merged with a name right next to it
names =
#   Jane Doe
#   DOE JANE
roles =
#   Project Coordinator
